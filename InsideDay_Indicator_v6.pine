//@version=6
indicator("Inside Day with Results", overlay = true)

// Inputs
length_ATR = input.int(defval = 40, title = "ATR Period Length", minval = 2)
atr_threshold = input.float(defval = 15.0, title = "ATR Threshold Percentage", minval = 0, maxval = 100) / 100

// Inside Day Detection
// An inside day is when both high and low are within the previous day's range
insideDay = high < high[1] and low > low[1]
insideDayPrev = high[1] < high[2] and low[1] > low[2]

// ATR Calculation
range_ATR = ta.atr(length_ATR)

// Follow-through logic for day after Inside Day
// If previous bar was an Inside Day, check current bar's performance
inside_day_high = high[1]
inside_day_low = low[1]
inside_day_atr = range_ATR[1]

// Calculate thresholds (15% of ATR)
atr_offset = inside_day_atr * atr_threshold
upper_threshold = inside_day_high + atr_offset
lower_threshold = inside_day_low - atr_offset

// Check if we're on the day after an Inside Day
is_day_after_inside = insideDayPrev

// Winning trade scenarios:
// 1. Reached BOTH profit targets (+15% ATR AND -15% ATR)
// 2. Reached upper target without breaking below Inside Day low (clean upside)
// 3. Reached lower target without breaking above Inside Day high (clean downside)
reached_both_thresholds = (high >= upper_threshold) and (low <= lower_threshold)
reached_upper_only_clean = (high >= upper_threshold) and (low > inside_day_low)
reached_lower_only_clean = (low <= lower_threshold) and (high < inside_day_high)

strong_breakout = is_day_after_inside and (reached_both_thresholds or reached_upper_only_clean or reached_lower_only_clean)

// Losing trade: broke Inside Day range but didn't qualify as a winning trade
losing_trade = is_day_after_inside and (high > inside_day_high or low < inside_day_low) and not strong_breakout

// Visual outputs
// Blue triangle for current Inside Day
plotshape(insideDay ? low : na, style = shape.triangleup, color = color.new(color.blue, 0), location = location.belowbar, size = size.small, title = "Inside Day")

// Green diamond for winning trade (day after Inside Day)
plotshape(strong_breakout ? low : na, style = shape.diamond, color = color.new(color.green, 0), location = location.abovebar, size = size.normal, title = "Winning Trade")

// Black diamond for losing trade (day after Inside Day)
plotshape(losing_trade ? low : na, style = shape.diamond, color = color.new(color.black, 0), location = location.abovebar, size = size.normal, title = "Losing Trade")
