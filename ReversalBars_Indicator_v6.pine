//@version=6
indicator("Reversal Bars with Results", overlay = true)

// Inputs
length_ATR = input.int(defval = 40, title = "ATR Period Length", minval = 2)
atr_threshold = input.float(defval = 15.0, title = "ATR Threshold Percentage", minval = 0, maxval = 100) / 100
min_breakout_pips = input.float(defval = 3.0, title = "Minimum Breakout (Pips)", minval = 0)
pip_value = input.float(defval = 0.0001, title = "Pip Value (0.0001 for Forex, 0.01 for JPY pairs, 1.0 for stocks)")
bullColor = input.color(color.new(color.green, 0), "Bullish Reversal Color")
bearColor = input.color(color.new(color.red, 0), "Bearish Reversal Color")
showLabels = input.bool(true, "Show Labels")

// Statistics Settings
show_stats = input.bool(defval = true, title = "Show Statistics Table")
use_date_filter = input.bool(defval = false, title = "Use Date Range Filter")
start_date = input.time(defval = timestamp("2020-01-01 00:00"), title = "Start Date")
end_date = input.time(defval = timestamp("2025-12-31 23:59"), title = "End Date")

// Reversal Bar Detection
// Bullish: low < low[1] AND close > close[1] AND open <= close
// Bearish: high > high[1] AND close < close[1] AND open >= close
bullishReversal = (low < low[1]) and (close > close[1]) and (open <= close)
bearishReversal = (high > high[1]) and (close < close[1]) and (open >= close)

// Previous bar reversal detection
bullishReversalPrev = (low[1] < low[2]) and (close[1] > close[2]) and (open[1] <= close[1])
bearishReversalPrev = (high[1] > high[2]) and (close[1] < close[2]) and (open[1] >= close[1])

// Check if previous bar was any reversal
anyReversalPrev = bullishReversalPrev or bearishReversalPrev

// ATR Calculation
range_ATR = ta.atr(length_ATR)

// Follow-through logic for day after Reversal Bar
// If previous bar was a Reversal Bar, check current bar's performance
reversal_bar_high = high[1]
reversal_bar_low = low[1]
reversal_bar_atr = range_ATR[1]

// Calculate minimum breakout threshold in price
min_breakout_amount = min_breakout_pips * pip_value

// Check if breakout meets minimum pip requirement
broke_high_enough = high > (reversal_bar_high + min_breakout_amount)
broke_low_enough = low < (reversal_bar_low - min_breakout_amount)
valid_breakout = broke_high_enough or broke_low_enough

// Calculate thresholds (15% of ATR)
atr_offset = reversal_bar_atr * atr_threshold
upper_threshold = reversal_bar_high + atr_offset
lower_threshold = reversal_bar_low - atr_offset

// Check if we're on the day after a Reversal Bar
is_day_after_reversal = anyReversalPrev

// Winning trade scenarios:
// 1. Reached BOTH profit targets (+15% ATR AND -15% ATR)
// 2. Reached upper target without breaking below Reversal Bar low (clean upside)
// 3. Reached lower target without breaking above Reversal Bar high (clean downside)
reached_both_thresholds = (high >= upper_threshold) and (low <= lower_threshold)
reached_upper_only_clean = (high >= upper_threshold) and (low > reversal_bar_low)
reached_lower_only_clean = (low <= lower_threshold) and (high < reversal_bar_high)

strong_breakout = is_day_after_reversal and valid_breakout and (reached_both_thresholds or reached_upper_only_clean or reached_lower_only_clean)

// Losing trade: met minimum breakout requirement but didn't qualify as a winning trade
losing_trade = is_day_after_reversal and valid_breakout and not strong_breakout

// Check if current bar is within date range
in_date_range = use_date_filter ? (time >= start_date and time <= end_date) : true

// Count trades within date range
var int winning_count = 0
var int losing_count = 0

if strong_breakout and in_date_range
    winning_count += 1

if losing_trade and in_date_range
    losing_count += 1

// Calculate statistics
total_trades = winning_count + losing_count
win_rate = total_trades > 0 ? (winning_count / total_trades) * 100 : 0

// Visual outputs
// Original reversal bar signals
plotshape(bullishReversal, title="Bullish Reversal", location=location.belowbar, color=bullColor, style=shape.triangleup, text="Bull", textcolor=bullColor, size=size.small, display=showLabels ? display.all : display.none)
plotshape(bearishReversal, title="Bearish Reversal", location=location.abovebar, color=bearColor, style=shape.triangledown, text="Bear", textcolor=bearColor, size=size.small, display=showLabels ? display.all : display.none)

// Background color for reversal bars
bgcolor(bullishReversal ? color.new(bullColor, 80) : na)
bgcolor(bearishReversal ? color.new(bearColor, 80) : na)

// Green diamond for winning trade (day after Reversal Bar)
plotshape(strong_breakout ? low : na, style = shape.diamond, color = color.new(color.green, 0), location = location.abovebar, size = size.normal, title = "Winning Trade")

// Red diamond for losing trade (day after Reversal Bar)
plotshape(losing_trade ? low : na, style = shape.diamond, color = color.new(color.red, 0), location = location.abovebar, size = size.normal, title = "Losing Trade")

// Statistics Table
if show_stats
    var table stats_table = table.new(position.top_right, 2, 5, border_width = 1)

    if barstate.islast
        // Header
        table.cell(stats_table, 0, 0, "Reversal Bar Results", text_color = color.white, bgcolor = color.blue, text_size = size.normal)
        table.merge_cells(stats_table, 0, 0, 1, 0)

        // Winning Trades
        table.cell(stats_table, 0, 1, "Winning:", text_color = color.white, bgcolor = color.new(color.gray, 50), text_size = size.normal)
        table.cell(stats_table, 1, 1, str.tostring(winning_count), text_color = color.green, bgcolor = color.new(color.gray, 50), text_size = size.normal)

        // Losing Trades
        table.cell(stats_table, 0, 2, "Losing:", text_color = color.white, bgcolor = color.new(color.gray, 50), text_size = size.normal)
        table.cell(stats_table, 1, 2, str.tostring(losing_count), text_color = color.red, bgcolor = color.new(color.gray, 50), text_size = size.normal)

        // Win Rate
        table.cell(stats_table, 0, 3, "Win Rate:", text_color = color.white, bgcolor = color.new(color.gray, 50), text_size = size.normal)
        table.cell(stats_table, 1, 3, str.format("{0,number,#.##}%", win_rate), text_color = color.white, bgcolor = color.new(color.gray, 50), text_size = size.normal)

        // Total Trades
        table.cell(stats_table, 0, 4, "Total:", text_color = color.white, bgcolor = color.new(color.gray, 50), text_size = size.normal)
        table.cell(stats_table, 1, 4, str.tostring(total_trades), text_color = color.white, bgcolor = color.new(color.gray, 50), text_size = size.normal)
