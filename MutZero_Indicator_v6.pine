//@version=6
indicator("MutZero Indicator", overlay = true)

// Inputs
length_ATR = input.int(defval = 40, title = "ATR Period Length", minval = 2)
tp_mode = input.string(defval = "ATR %", title = "Take Profit Mode", options = ["ATR %", "Fixed Pips"])
take_profit_pct = input.float(defval = 15.0, title = "Take Profit (% of ATR)", minval = 0, maxval = 100)
take_profit_pips = input.float(defval = 50.0, title = "Take Profit (Pips)", minval = 0)
min_breakout_pips = input.float(defval = 3.0, title = "Minimum Breakout (Pips)", minval = 0)
pip_value = input.float(defval = 0.0001, title = "Pip Value (0.0001 for Forex, 0.01 for JPY pairs, 1.0 for stocks)")

// Statistics Settings
show_stats = input.bool(defval = true, title = "Show Statistics Table")
use_date_filter = input.bool(defval = false, title = "Use Date Range Filter")
start_date = input.time(defval = timestamp("2020-01-01 00:00"), title = "Start Date")
end_date = input.time(defval = timestamp("2025-12-31 23:59"), title = "End Date")

// Profitability Settings
starting_account = input.float(defval = 10000.0, title = "Starting Account ($)", minval = 0)
risk_per_trade = input.float(defval = 2.0, title = "Risk Per Trade (%)", minval = 0, maxval = 100)

// ATR Calculation
range_ATR = ta.atr(length_ATR)

// Analyze EVERY bar - treat each day as a potential setup
// Check the current bar's performance relative to the previous bar
prev_day_high = high[1]
prev_day_low = low[1]
prev_day_atr = range_ATR[1]

// Calculate minimum breakout threshold in price
min_breakout_amount = min_breakout_pips * pip_value

// Check if breakout meets minimum pip requirement
broke_high_enough = high > (prev_day_high + min_breakout_amount)
broke_low_enough = low < (prev_day_low - min_breakout_amount)
valid_breakout = broke_high_enough or broke_low_enough

// Calculate thresholds based on selected mode
atr_offset = tp_mode == "ATR %" ? prev_day_atr * (take_profit_pct / 100) : take_profit_pips * pip_value
upper_threshold = prev_day_high + atr_offset
lower_threshold = prev_day_low - atr_offset

// Check if both sides were broken
broke_both_sides = broke_high_enough and broke_low_enough

// Standard winning conditions (for when only one side is broken)
reached_both_thresholds = (high >= upper_threshold) and (low <= lower_threshold)
reached_upper_only_clean = (high >= upper_threshold) and (low > prev_day_low)
reached_lower_only_clean = (low <= lower_threshold) and (high < prev_day_high)
closed_above_entry = close > (prev_day_high + min_breakout_amount)
closed_below_entry = close < (prev_day_low - min_breakout_amount)

// Winning/Losing trade logic
winning_trade = false
losing_trade = false

if valid_breakout
    if broke_both_sides
        // Both sides broken - calculate net P&L to determine win/loss

        // Long side P&L
        long_entry = prev_day_high + min_breakout_amount
        long_pnl = 0.0
        if high >= upper_threshold
            // Long TP hit
            long_pnl := atr_offset
        else
            // Long stopped out at Mut day low
            long_pnl := prev_day_low - long_entry  // Negative

        // Short side P&L
        short_entry = prev_day_low - min_breakout_amount
        short_pnl = 0.0
        if low <= lower_threshold
            // Short TP hit
            short_pnl := atr_offset
        else
            // Short stopped out at Mut day high
            short_pnl := short_entry - prev_day_high  // Negative

        // Net P&L determines win/loss
        net_pnl = long_pnl + short_pnl

        if net_pnl > 0
            winning_trade := true
        else
            losing_trade := true
    else
        // Only one side broken - use standard logic
        if reached_both_thresholds or reached_upper_only_clean or reached_lower_only_clean or closed_above_entry or closed_below_entry
            winning_trade := true
        else
            losing_trade := true

// Check if current bar is within date range
in_date_range = use_date_filter ? (time >= start_date and time <= end_date) : true

// Count trades within date range
var int winning_count = 0
var int losing_count = 0
var float account_balance = starting_account

if winning_trade and in_date_range
    winning_count += 1
    // Add risk% to account for winning trade
    account_balance := account_balance + (account_balance * (risk_per_trade / 100))

if losing_trade and in_date_range
    losing_count += 1
    // Subtract risk% from account for losing trade
    account_balance := account_balance - (account_balance * (risk_per_trade / 100))

// Calculate statistics
total_trades = winning_count + losing_count
win_rate = total_trades > 0 ? (winning_count / total_trades) * 100 : 0
profit_loss_pct = ((account_balance - starting_account) / starting_account) * 100

// Visual outputs
// Green diamond for winning trade
plotshape(winning_trade ? low : na, style = shape.diamond, color = color.new(color.green, 0), location = location.abovebar, size = size.normal, title = "Winning Trade")

// Red diamond for losing trade
plotshape(losing_trade ? low : na, style = shape.diamond, color = color.new(color.red, 0), location = location.abovebar, size = size.normal, title = "Losing Trade")

// Statistics Table
if show_stats
    var table stats_table = table.new(position.top_right, 2, 8, border_width = 1)

    if barstate.islast
        // Header
        table.cell(stats_table, 0, 0, "MutZero Results", text_color = color.white, bgcolor = color.blue, text_size = size.normal)
        table.merge_cells(stats_table, 0, 0, 1, 0)

        // Winning Trades
        table.cell(stats_table, 0, 1, "Winning:", text_color = color.white, bgcolor = color.new(color.gray, 50), text_size = size.normal)
        table.cell(stats_table, 1, 1, str.tostring(winning_count), text_color = color.white, bgcolor = color.new(color.gray, 50), text_size = size.normal)

        // Losing Trades
        table.cell(stats_table, 0, 2, "Losing:", text_color = color.white, bgcolor = color.new(color.gray, 50), text_size = size.normal)
        table.cell(stats_table, 1, 2, str.tostring(losing_count), text_color = color.white, bgcolor = color.new(color.gray, 50), text_size = size.normal)

        // Win Rate
        table.cell(stats_table, 0, 3, "Win Rate:", text_color = color.white, bgcolor = color.new(color.gray, 50), text_size = size.normal)
        table.cell(stats_table, 1, 3, str.format("{0,number,#.##}%", win_rate), text_color = color.white, bgcolor = color.new(color.gray, 50), text_size = size.normal)

        // Total Trades
        table.cell(stats_table, 0, 4, "Total:", text_color = color.white, bgcolor = color.new(color.gray, 50), text_size = size.normal)
        table.cell(stats_table, 1, 4, str.tostring(total_trades), text_color = color.white, bgcolor = color.new(color.gray, 50), text_size = size.normal)

        // Starting Account
        table.cell(stats_table, 0, 5, "Starting $:", text_color = color.white, bgcolor = color.new(color.gray, 50), text_size = size.normal)
        table.cell(stats_table, 1, 5, str.format("${0,number,#.##}", starting_account), text_color = color.white, bgcolor = color.new(color.gray, 50), text_size = size.normal)

        // Final Account
        table.cell(stats_table, 0, 6, "Final $:", text_color = color.white, bgcolor = color.new(color.gray, 50), text_size = size.normal)
        table.cell(stats_table, 1, 6, str.format("${0,number,#.##}", account_balance), text_color = color.white, bgcolor = color.new(color.gray, 50), text_size = size.normal)

        // P/L %
        table.cell(stats_table, 0, 7, "P/L %:", text_color = color.white, bgcolor = color.new(color.gray, 50), text_size = size.normal)
        table.cell(stats_table, 1, 7, str.format("{0,number,#.##}%", profit_loss_pct), text_color = color.white, bgcolor = color.new(color.gray, 50), text_size = size.normal)
